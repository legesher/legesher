# Validate Commit Messages
# This workflow validates that all commits in a PR follow the Conventional Commits format
# Required for semantic-release to work correctly
#
# To enable: rename this file to validate-commits.yml (remove .disabled)

name: Validate Commit Messages

on:
  pull_request:
    types: [opened, synchronize, reopened]

jobs:
  commitlint:
    name: Validate Conventional Commits
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0  # Fetch all history for commit validation

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.13'

      - name: Install uv
        uses: astral-sh/setup-uv@v4
        with:
          version: "latest"

      - name: Install commitizen
        run: uv pip install --system commitizen

      - name: Validate commit messages
        run: |
          # Get list of commits in PR
          COMMITS=$(git log --format=%H origin/${{ github.base_ref }}..HEAD)

          # Validate each commit
          echo "Validating commits in PR..."
          for commit in $COMMITS; do
            echo "Checking commit: $commit"
            git log --format=%B -n 1 $commit | head -n 1
            if ! cz check --rev-range $commit~1..$commit; then
              echo "❌ Commit $commit does not follow conventional commits format"
              echo ""
              echo "Expected format: <type>(<scope>): <subject>"
              echo "Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
              echo "Scopes: core, i18n, legesher, language-server, vs-code, pride, i18n-python-es, i18n-python-ar"
              echo ""
              echo "Examples:"
              echo "  feat(core): add translation engine"
              echo "  fix(i18n): correct Spanish keyword mappings"
              echo "  docs: update README with new examples"
              exit 1
            fi
          done

          echo "✅ All commits follow conventional commits format"

      - name: Summary
        if: success()
        run: |
          echo "### ✅ Commit Validation Passed" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "All commits in this PR follow the Conventional Commits format." >> $GITHUB_STEP_SUMMARY
