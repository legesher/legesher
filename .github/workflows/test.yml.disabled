name: Tests

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]

jobs:
  test:
    runs-on: ${{ matrix.os }}
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
        python-version: ['3.10', '3.11', '3.12', '3.13']

    steps:
      - name: Checkout code
        uses: actions/checkout@692973e3d937129bcbf40652eb9f2f61becf3332 # v4.1.7

      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@f677139bbe7f9c59b41e40162b753c062f5d49a3 # v5.2.0
        with:
          python-version: ${{ matrix.python-version }}

      - name: Install uv
        uses: astral-sh/setup-uv@2ddd2b9cb38ad8efd50337e8ab201519a34c9f24 # v7.1.1
        with:
          enable-cache: true

      - name: Cache UV dependencies
        uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4.3.0
        with:
          key: ${{ runner.os }}-uv-${{ hashFiles('**/pyproject.toml') }}
          path: ~/.cache/uv
          restore-keys: |
            ${{ runner.os }}-uv-

      - name: Install dependencies
        run: uv sync --all-extras

      - name: Run tests - legesher-core
        run: |
          cd libs/core
          uv run pytest --cov=legesher_core --cov-report=xml --cov-report=term-missing
        continue-on-error: false

      - name: Run tests - legesher-i18n
        run: |
          cd libs/i18n
          uv run pytest --cov=legesher_i18n --cov-report=xml --cov-report=term-missing
        continue-on-error: false

      - name: Run tests - legesher
        run: |
          cd libs/legesher
          uv run pytest --cov=legesher --cov-report=xml --cov-report=term-missing
        continue-on-error: false

      - name: Run tests - legesher-language-server
        run: |
          cd libs/language-server
          uv run pytest --cov=legesher_language_server --cov-report=xml --cov-report=term-missing
        continue-on-error: false
