{
 "implementation": "cpython",
 "version_added": "3.10",
 "provenance": "CPython error-message catalog (CORE-1679). Templates transcribed from CPython 3.10-3.13 runtime messages; 3.12+ rewordings and additions are separate rows keyed by version_added, and the 3.11 UnboundLocalError rewording carries version_removed on the pre-3.11 row. Translations are not in this file: each language pack carries its own, in its `messages` section, exported from the translations database (CORE-2630). Stored templates are clean of bidi controls; isolation of interpolated values is applied at render time per the ratified code-vs-display policy.",
 "templates": [
  {
   "key": "traceback.header",
   "template_en": "Traceback (most recent call last):",
   "placeholders": [],
   "matcher": "^Traceback \\(most recent call last\\):$",
   "version_added": "3.10",
   "cluster": "traceback"
  },
  {
   "key": "traceback.frame",
   "template_en": "File \"{file}\", line {line}, in {name}",
   "placeholders": [
    {
     "name": "file",
     "example": "example.py"
    },
    {
     "name": "line",
     "example": "7",
     "kind": "line"
    },
    {
     "name": "name",
     "example": "<module>"
    }
   ],
   "matcher": "^File \"(?P<file>[^\"]+)\", line (?P<line>\\d+), in (?P<name>.+)$",
   "version_added": "3.10",
   "cluster": "traceback"
  },
  {
   "key": "traceback.frame_no_scope",
   "template_en": "File \"{file}\", line {line}",
   "placeholders": [
    {
     "name": "file",
     "example": "example.py"
    },
    {
     "name": "line",
     "example": "7",
     "kind": "line"
    }
   ],
   "matcher": "^File \"(?P<file>[^\"]+)\", line (?P<line>\\d+)$",
   "version_added": "3.10",
   "cluster": "traceback"
  },
  {
   "key": "traceback.cause",
   "template_en": "The above exception was the direct cause of the following exception:",
   "placeholders": [],
   "matcher": "^The above exception was the direct cause of the following exception:$",
   "version_added": "3.10",
   "cluster": "traceback"
  },
  {
   "key": "traceback.context",
   "template_en": "During handling of the above exception, another exception occurred:",
   "placeholders": [],
   "matcher": "^During handling of the above exception, another exception occurred:$",
   "version_added": "3.10",
   "cluster": "traceback"
  },
  {
   "key": "SyntaxError.invalid_syntax",
   "template_en": "invalid syntax",
   "placeholders": [],
   "matcher": "^invalid syntax$",
   "version_added": "3.10"
  },
  {
   "key": "SyntaxError.invalid_syntax_comma",
   "template_en": "invalid syntax. Perhaps you forgot a comma?",
   "placeholders": [],
   "matcher": "^invalid syntax\\. Perhaps you forgot a comma\\?$",
   "version_added": "3.10"
  },
  {
   "key": "SyntaxError.missing_parentheses_print",
   "template_en": "Missing parentheses in call to 'print'. Did you mean print(...)?",
   "placeholders": [],
   "matcher": "^Missing parentheses in call to 'print'\\. Did you mean print\\(\\.\\.\\.\\)\\?$",
   "version_added": "3.10"
  },
  {
   "key": "SyntaxError.cannot_assign_literal",
   "template_en": "cannot assign to literal here. Maybe you meant '==' instead of '='?",
   "placeholders": [],
   "matcher": "^cannot assign to literal here\\. Maybe you meant '==' instead of '='\\?$",
   "version_added": "3.10"
  },
  {
   "key": "SyntaxError.cannot_assign_expression",
   "template_en": "cannot assign to expression here. Maybe you meant '==' instead of '='?",
   "placeholders": [],
   "matcher": "^cannot assign to expression here\\. Maybe you meant '==' instead of '='\\?$",
   "version_added": "3.10"
  },
  {
   "key": "SyntaxError.unterminated_string",
   "template_en": "unterminated string literal (detected at line {line})",
   "placeholders": [
    {
     "name": "line",
     "example": "3",
     "kind": "line"
    }
   ],
   "matcher": "^unterminated string literal \\(detected at line (?P<line>\\d+)\\)$",
   "version_added": "3.10"
  },
  {
   "key": "SyntaxError.unterminated_triple_string",
   "template_en": "unterminated triple-quoted string literal (detected at line {line})",
   "placeholders": [
    {
     "name": "line",
     "example": "3",
     "kind": "line"
    }
   ],
   "matcher": "^unterminated triple-quoted string literal \\(detected at line (?P<line>\\d+)\\)$",
   "version_added": "3.10"
  },
  {
   "key": "SyntaxError.bracket_never_closed",
   "template_en": "'{bracket}' was never closed",
   "placeholders": [
    {
     "name": "bracket",
     "example": "("
    }
   ],
   "matcher": "^'(?P<bracket>[(\\[{])' was never closed$",
   "version_added": "3.10"
  },
  {
   "key": "SyntaxError.expected_colon",
   "template_en": "expected ':'",
   "placeholders": [],
   "matcher": "^expected ':'$",
   "version_added": "3.10"
  },
  {
   "key": "SyntaxError.leading_zeros",
   "template_en": "leading zeros in decimal integer literals are not permitted; use an 0o prefix for octal integers",
   "placeholders": [],
   "matcher": "^leading zeros in decimal integer literals are not permitted; use an 0o prefix for octal integers$",
   "version_added": "3.10"
  },
  {
   "key": "SyntaxError.import_from_suggestion",
   "template_en": "Did you mean to use 'from ... import ...' instead?",
   "placeholders": [],
   "matcher": "^Did you mean to use 'from \\.\\.\\. import \\.\\.\\.' instead\\?$",
   "version_added": "3.12"
  },
  {
   "key": "SyntaxError.fstring_valid_expression",
   "template_en": "f-string: valid expression required before '}'",
   "placeholders": [],
   "matcher": "^f-string: valid expression required before '}'$",
   "version_added": "3.12"
  },
  {
   "key": "NameError.not_defined",
   "template_en": "name '{name}' is not defined",
   "placeholders": [
    {
     "name": "name",
     "example": "contador"
    }
   ],
   "matcher": "^name '(?P<name>[^']+)' is not defined$",
   "version_added": "3.10"
  },
  {
   "key": "NameError.self_suggestion",
   "template_en": "name '{name}' is not defined. Did you mean: 'self.{name}'?",
   "placeholders": [
    {
     "name": "name",
     "example": "valor"
    }
   ],
   "matcher": "^name '(?P<name>[^']+)' is not defined\\. Did you mean: 'self\\.(?P=name)'\\?$",
   "version_added": "3.12"
  },
  {
   "key": "NameError.not_defined_did_you_mean",
   "template_en": "name '{name}' is not defined. Did you mean: '{suggestion}'?",
   "placeholders": [
    {
     "name": "name",
     "example": "prin"
    },
    {
     "name": "suggestion",
     "example": "print"
    }
   ],
   "matcher": "^name '(?P<name>[^']+)' is not defined\\. Did you mean: '(?P<suggestion>[^']+)'\\?$",
   "version_added": "3.10"
  },
  {
   "key": "NameError.forgot_import",
   "template_en": "name '{name}' is not defined. Did you forget to import '{module}'?",
   "placeholders": [
    {
     "name": "name",
     "example": "sys"
    },
    {
     "name": "module",
     "example": "sys"
    }
   ],
   "matcher": "^name '(?P<name>[^']+)' is not defined\\. Did you forget to import '(?P<module>[^']+)'\\?$",
   "version_added": "3.12"
  },
  {
   "key": "TypeError.unsupported_operand",
   "template_en": "unsupported operand type(s) for {op}: '{left}' and '{right}'",
   "placeholders": [
    {
     "name": "op",
     "example": "+"
    },
    {
     "name": "left",
     "example": "int"
    },
    {
     "name": "right",
     "example": "str"
    }
   ],
   "matcher": "^unsupported operand type\\(s\\) for (?P<op>[^:]+): '(?P<left>[^']+)' and '(?P<right>[^']+)'$",
   "version_added": "3.10"
  },
  {
   "key": "TypeError.not_callable",
   "template_en": "'{obj_type}' object is not callable",
   "placeholders": [
    {
     "name": "obj_type",
     "example": "int"
    }
   ],
   "matcher": "^'(?P<obj_type>[^']+)' object is not callable$",
   "version_added": "3.10"
  },
  {
   "key": "TypeError.not_subscriptable",
   "template_en": "'{obj_type}' object is not subscriptable",
   "placeholders": [
    {
     "name": "obj_type",
     "example": "int"
    }
   ],
   "matcher": "^'(?P<obj_type>[^']+)' object is not subscriptable$",
   "version_added": "3.10"
  },
  {
   "key": "TypeError.not_iterable",
   "template_en": "'{obj_type}' object is not iterable",
   "placeholders": [
    {
     "name": "obj_type",
     "example": "int"
    }
   ],
   "matcher": "^'(?P<obj_type>[^']+)' object is not iterable$",
   "version_added": "3.10"
  },
  {
   "key": "TypeError.arg_count",
   "template_en": "{func}() takes {expected} positional arguments but {given} were given",
   "placeholders": [
    {
     "name": "func",
     "example": "saludar"
    },
    {
     "name": "expected",
     "example": "2",
     "kind": "count"
    },
    {
     "name": "given",
     "example": "3",
     "kind": "count"
    }
   ],
   "matcher": "^(?P<func>.+)\\(\\) takes (?P<expected>\\d+) positional arguments? but (?P<given>\\d+) (?:was|were) given$",
   "version_added": "3.10"
  },
  {
   "key": "TypeError.missing_argument",
   "template_en": "{func}() missing {count} required positional argument: '{name}'",
   "placeholders": [
    {
     "name": "func",
     "example": "saludar"
    },
    {
     "name": "count",
     "example": "1",
     "kind": "count"
    },
    {
     "name": "name",
     "example": "nombre"
    }
   ],
   "matcher": "^(?P<func>.+)\\(\\) missing (?P<count>\\d+) required positional argument: '(?P<name>[^']+)'$",
   "version_added": "3.10"
  },
  {
   "key": "TypeError.missing_arguments",
   "template_en": "{func}() missing {count} required positional arguments: {names}",
   "placeholders": [
    {
     "name": "func",
     "example": "saludar"
    },
    {
     "name": "count",
     "example": "2",
     "kind": "count"
    },
    {
     "name": "names",
     "example": "'a' and 'b'"
    }
   ],
   "matcher": "^(?P<func>.+)\\(\\) missing (?P<count>\\d+) required positional arguments: (?P<names>.+)$",
   "version_added": "3.10"
  },
  {
   "key": "TypeError.can_only_concatenate_str",
   "template_en": "can only concatenate str (not \"{other_type}\") to str",
   "placeholders": [
    {
     "name": "other_type",
     "example": "int"
    }
   ],
   "matcher": "^can only concatenate str \\(not \"(?P<other_type>[^\"]+)\"\\) to str$",
   "version_added": "3.10"
  },
  {
   "key": "AttributeError.no_attribute",
   "template_en": "'{obj_type}' object has no attribute '{attr}'",
   "placeholders": [
    {
     "name": "obj_type",
     "example": "list"
    },
    {
     "name": "attr",
     "example": "add"
    }
   ],
   "matcher": "^'(?P<obj_type>[^']+)' object has no attribute '(?P<attr>[^']+)'$",
   "version_added": "3.10"
  },
  {
   "key": "AttributeError.no_attribute_did_you_mean",
   "template_en": "'{obj_type}' object has no attribute '{attr}'. Did you mean: '{suggestion}'?",
   "placeholders": [
    {
     "name": "obj_type",
     "example": "list"
    },
    {
     "name": "attr",
     "example": "apend"
    },
    {
     "name": "suggestion",
     "example": "append"
    }
   ],
   "matcher": "^'(?P<obj_type>[^']+)' object has no attribute '(?P<attr>[^']+)'\\. Did you mean: '(?P<suggestion>[^']+)'\\?$",
   "version_added": "3.10"
  },
  {
   "key": "AttributeError.module_no_attribute",
   "template_en": "module '{module}' has no attribute '{attr}'",
   "placeholders": [
    {
     "name": "module",
     "example": "math"
    },
    {
     "name": "attr",
     "example": "cuadrado"
    }
   ],
   "matcher": "^module '(?P<module>[^']+)' has no attribute '(?P<attr>[^']+)'$",
   "version_added": "3.10"
  },
  {
   "key": "ImportError.cannot_import_name",
   "template_en": "cannot import name '{name}' from '{module}'",
   "placeholders": [
    {
     "name": "name",
     "example": "sumar"
    },
    {
     "name": "module",
     "example": "utilidades"
    }
   ],
   "matcher": "^cannot import name '(?P<name>[^']+)' from '(?P<module>[^']+)'.*$",
   "version_added": "3.10"
  },
  {
   "key": "ModuleNotFoundError.no_module",
   "template_en": "No module named '{module}'",
   "placeholders": [
    {
     "name": "module",
     "example": "utilidades"
    }
   ],
   "matcher": "^No module named '(?P<module>[^']+)'$",
   "version_added": "3.10"
  },
  {
   "key": "IndexError.list_index",
   "template_en": "list index out of range",
   "placeholders": [],
   "matcher": "^list index out of range$",
   "version_added": "3.10"
  },
  {
   "key": "IndexError.string_index",
   "template_en": "string index out of range",
   "placeholders": [],
   "matcher": "^string index out of range$",
   "version_added": "3.10"
  },
  {
   "key": "KeyError.key",
   "template_en": "{key}",
   "placeholders": [
    {
     "name": "key",
     "example": "'edad'"
    }
   ],
   "matcher": "^(?P<key>.+)$",
   "version_added": "3.10"
  },
  {
   "key": "ValueError.int_literal",
   "template_en": "invalid literal for int() with base {base}: {value}",
   "placeholders": [
    {
     "name": "base",
     "example": "10"
    },
    {
     "name": "value",
     "example": "'abc'"
    }
   ],
   "matcher": "^invalid literal for int\\(\\) with base (?P<base>\\d+): (?P<value>.+)$",
   "version_added": "3.10"
  },
  {
   "key": "ValueError.too_many_unpack",
   "template_en": "too many values to unpack (expected {expected})",
   "placeholders": [
    {
     "name": "expected",
     "example": "2",
     "kind": "count"
    }
   ],
   "matcher": "^too many values to unpack \\(expected (?P<expected>\\d+)\\)$",
   "version_added": "3.10"
  },
  {
   "key": "ValueError.not_enough_unpack",
   "template_en": "not enough values to unpack (expected {expected}, got {got})",
   "placeholders": [
    {
     "name": "expected",
     "example": "3",
     "kind": "count"
    },
    {
     "name": "got",
     "example": "2",
     "kind": "count"
    }
   ],
   "matcher": "^not enough values to unpack \\(expected (?P<expected>\\d+), got (?P<got>\\d+)\\)$",
   "version_added": "3.10"
  },
  {
   "key": "ZeroDivisionError.division_by_zero",
   "template_en": "division by zero",
   "placeholders": [],
   "matcher": "^division by zero$",
   "version_added": "3.10"
  },
  {
   "key": "ZeroDivisionError.float_division",
   "template_en": "float division by zero",
   "placeholders": [],
   "matcher": "^float division by zero$",
   "version_added": "3.10"
  },
  {
   "key": "ZeroDivisionError.int_division_or_modulo",
   "template_en": "integer division or modulo by zero",
   "placeholders": [],
   "matcher": "^integer division or modulo by zero$",
   "version_added": "3.10"
  },
  {
   "key": "IndentationError.expected_block",
   "template_en": "expected an indented block after '{statement}' statement on line {line}",
   "placeholders": [
    {
     "name": "statement",
     "example": "if"
    },
    {
     "name": "line",
     "example": "2",
     "kind": "line"
    }
   ],
   "matcher": "^expected an indented block after '(?P<statement>[^']+)' statement on line (?P<line>\\d+)$",
   "version_added": "3.10"
  },
  {
   "key": "IndentationError.unexpected_indent",
   "template_en": "unexpected indent",
   "placeholders": [],
   "matcher": "^unexpected indent$",
   "version_added": "3.10"
  },
  {
   "key": "IndentationError.unindent_mismatch",
   "template_en": "unindent does not match any outer indentation level",
   "placeholders": [],
   "matcher": "^unindent does not match any outer indentation level$",
   "version_added": "3.10"
  },
  {
   "key": "TabError.inconsistent",
   "template_en": "inconsistent use of tabs and spaces in indentation",
   "placeholders": [],
   "matcher": "^inconsistent use of tabs and spaces in indentation$",
   "version_added": "3.10"
  },
  {
   "key": "FileNotFoundError.enoent",
   "template_en": "[Errno {errno}] No such file or directory: {filename}",
   "placeholders": [
    {
     "name": "errno",
     "example": "2"
    },
    {
     "name": "filename",
     "example": "'datos.txt'"
    }
   ],
   "matcher": "^\\[Errno (?P<errno>\\d+)\\] No such file or directory: (?P<filename>.+)$",
   "version_added": "3.10"
  },
  {
   "key": "RecursionError.max_depth",
   "template_en": "maximum recursion depth exceeded",
   "placeholders": [],
   "matcher": "^maximum recursion depth exceeded.*$",
   "version_added": "3.10"
  },
  {
   "key": "UnboundLocalError.before_assignment",
   "template_en": "local variable '{name}' referenced before assignment",
   "placeholders": [
    {
     "name": "name",
     "example": "total"
    }
   ],
   "matcher": "^local variable '(?P<name>[^']+)' referenced before assignment$",
   "version_added": "3.10",
   "version_removed": "3.11"
  },
  {
   "key": "UnboundLocalError.before_assignment",
   "template_en": "cannot access local variable '{name}' where it is not associated with a value",
   "placeholders": [
    {
     "name": "name",
     "example": "total"
    }
   ],
   "matcher": "^cannot access local variable '(?P<name>[^']+)' where it is not associated with a value$",
   "version_added": "3.11"
  },
  {
   "key": "RuntimeError.generator_raised_stopiteration",
   "template_en": "generator raised StopIteration",
   "placeholders": [],
   "matcher": "^generator raised StopIteration$",
   "version_added": "3.10"
  },
  {
   "key": "StopIteration.no_value",
   "template_en": "",
   "placeholders": [],
   "matcher": "^$",
   "version_added": "3.10"
  },
  {
   "key": "KeyboardInterrupt.interrupt",
   "template_en": "",
   "placeholders": [],
   "matcher": "^$",
   "version_added": "3.10"
  },
  {
   "key": "AssertionError.no_message",
   "template_en": "",
   "placeholders": [],
   "matcher": "^$",
   "version_added": "3.10"
  }
 ]
}
