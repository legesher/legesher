---
// In-browser Python playground (CORE-1551): edit localized Python, click Run to
// translate → execute it entirely client-side via Pyodide.
//
// v1 offers LTR pack languages only; RTL editing is CORE-1552. The offered set is
// snippet-langs filtered to non-RTL languages that have a vendored wheel in
// wheels-manifest.json. A pack added after the last build_wheels.sh run appears
// in the static snippets but is held out here until the wheels are rebuilt,
// rather than offered and failing on Run.
//
// These JSON artifacts are the same ones the static snippets use; importing them
// statically bundles their contents at build time.
import langsMeta from '../../.astro/integrations/legesher-snippets/snippet-langs.json';
import wheels from '../../public/wheels/wheels-manifest.json';
import helloWorld from '../../.astro/integrations/legesher-snippets/snippets/hello-world.json';
import loops from '../../.astro/integrations/legesher-snippets/snippets/loops.json';
import functions from '../../.astro/integrations/legesher-snippets/snippets/functions.json';
import classes from '../../.astro/integrations/legesher-snippets/snippets/classes.json';
import errorHandling from '../../.astro/integrations/legesher-snippets/snippets/error-handling.json';
import asyncAwait from '../../.astro/integrations/legesher-snippets/snippets/async-await.json';

type LangMeta = { code: string; native: string; name: string; rtl: boolean };
type Snippet = {
  slug: string;
  variants: Record<string, { code: string }>;
  identifiers?: Record<string, Record<string, string>>;
};
const meta = langsMeta as LangMeta[];

const vendored = new Set(Object.keys((wheels as { packs: Record<string, string> }).packs));
const offered = meta
  .filter((l) => !l.rtl && vendored.has(l.code))
  .map((l) => ({ code: l.code, native: l.native, name: l.name }));
const rtlNative = meta.filter((l) => l.rtl).map((l) => l.native);

// Curated samples on a difficulty ladder (CORE-1696). Each lives ONCE as
// canonical English in docs/snippets/*.py; the localized variants here are
// engine-generated by generate_snippets.py — the same pipeline the static
// docs snippets ride — never hand-written.
const sampleEntries: [string, Snippet][] = [
  ['Hello world', helloWorld as Snippet],
  ['Loops', loops as Snippet],
  ['Functions', functions as Snippet],
  ['Classes', classes as Snippet],
  ['Error handling', errorHandling as Snippet],
  ['Async and await', asyncAwait as Snippet],
];
const samples = sampleEntries.map(([label, snip]) => ({
  slug: snip.slug,
  label,
  code: Object.fromEntries(offered.map((l) => [l.code, snip.variants[l.code]?.code ?? ''])),
  // Pilot identifier glossaries ({lang: {english: localized}}); languages
  // without one fall back to English identifiers.
  identifiers: snip.identifiers ?? {},
}));

const data = { offered, samples, defaultLang: 'es' };
// Escape "<" so the JSON payload can't break out of the <script> element.
const dataJson = JSON.stringify(data).replace(/</g, '\\u003c');
---

<section class="pg" aria-label="Python playground">
  <div class="pg-toolbar">
    <label class="pg-lang-label">
      Language
      <select id="pg-lang" aria-label="Editor language">
        {offered.map((l) => <option value={l.code}>{l.native} ({l.code})</option>)}
      </select>
    </label>
    <label class="pg-lang-label">
      Sample
      <select id="pg-sample" aria-label="Code sample">
        {samples.map((s) => <option value={s.slug}>{s.label}</option>)}
      </select>
    </label>
    <button id="pg-run" type="button" class="pg-run">Run ▶</button>
    <button id="pg-share" type="button" class="pg-secondary">Copy link</button>
    <button id="pg-toggle" type="button" class="pg-secondary">Show English</button>
    <span id="pg-view-note" class="pg-status" hidden>English view</span>
    <span id="pg-status" class="pg-status" role="status" aria-live="polite" hidden></span>
  </div>

  <div id="pg-editor" class="pg-editor"></div>

  <div class="pg-output-wrap">
    <div class="pg-output-head">Output</div>
    <pre id="pg-output" class="pg-output" aria-live="polite" tabindex="0"></pre>
  </div>

  <p class="pg-rtl-note">
    Right-to-left languages ({rtlNative.join(', ')}) render in the docs but aren’t
    editable here yet — RTL editing is coming soon.
  </p>

  <script type="application/json" id="pg-data" set:html={dataJson}></script>
</section>

<script>
  import { mountEditor } from '../playground/editor';
  import { localizedHighlight, toTermSets, type HighlightTerms } from '../playground/highlight';
  import { invertGlossary, swapIdentifiers } from '../playground/identifiers';
  import { createRunner } from '../playground/runner';
  import { decodeShareCode, encodeShareCode } from '../playground/share';

  type Offered = { code: string; native: string; name: string };
  type Sample = {
    slug: string;
    label: string;
    code: Record<string, string>;
    identifiers: Record<string, Record<string, string>>;
  };
  type PgData = { offered: Offered[]; samples: Sample[]; defaultLang: string };

  const URL_SYNC_DEBOUNCE_MS = 500;

  const dataEl = document.getElementById('pg-data');
  const editorParent = document.getElementById('pg-editor');
  const langSel = document.getElementById('pg-lang') as HTMLSelectElement | null;
  const sampleSel = document.getElementById('pg-sample') as HTMLSelectElement | null;
  const runBtn = document.getElementById('pg-run') as HTMLButtonElement | null;
  const shareBtn = document.getElementById('pg-share') as HTMLButtonElement | null;
  const toggleBtn = document.getElementById('pg-toggle') as HTMLButtonElement | null;
  const viewNoteEl = document.getElementById('pg-view-note');
  const outputEl = document.getElementById('pg-output');
  const statusEl = document.getElementById('pg-status');

  if (dataEl && editorParent && langSel && sampleSel && runBtn && shareBtn && toggleBtn && viewNoteEl && outputEl && statusEl) {
    const { offered, samples, defaultLang } = JSON.parse(dataEl.textContent || '{}') as PgData;

    // Honor the docs-wide code-language preference when it's an offered pack,
    // else fall back to the default (Spanish). Fresh visitors get the default.
    let currentLang = defaultLang;
    try {
      const pref = localStorage.getItem('legesher-snippet-lang');
      if (pref && offered.some((l) => l.code === pref)) currentLang = pref;
    } catch {
      /* localStorage unavailable — keep default */
    }

    // Share-URL params (?code=<base64url>&src=en&tgt=<lang>&sample=<slug>,
    // CORE-1696) win over the stored preference; invalid values fall back
    // silently.
    const params = new URLSearchParams(location.search);
    const tgtParam = params.get('tgt');
    if (tgtParam && offered.some((l) => l.code === tgtParam)) currentLang = tgtParam;
    const codeParam = params.get('code');
    const sharedCode = codeParam == null ? null : decodeShareCode(codeParam);

    langSel.value = currentLang;

    let currentSample = samples[0]?.slug ?? '';
    // sample=<slug> rides the share URL so recipients get the same glossary
    // context for the toggle; unknown slugs fall back silently.
    const sampleParam = params.get('sample');
    if (sampleParam && samples.some((s) => s.slug === sampleParam)) currentSample = sampleParam;
    sampleSel.value = currentSample;
    const seedFor = () => samples.find((s) => s.slug === currentSample)?.code[currentLang] ?? '';
    // Pilot identifier glossary for the current sample+language, or null
    // (fallback languages keep English identifiers — no special-casing).
    const glossaryFor = () =>
      samples.find((s) => s.slug === currentSample)?.identifiers[currentLang] ?? null;

    // Source ↔ canonical toggle state (CORE-1696). The engine translates both
    // directions in the browser, so both views stay editable. Byte honesty:
    // the localized buffer is re-derived only when the canonical view was
    // actually edited; an untouched canonical view restores the saved bytes
    // verbatim on toggle-back.
    let view: 'source' | 'canonical' = 'source';
    let savedSource = '';
    let canonicalShown = '';
    let translating = false;

    // Localized highlight terms are generated per-language chunks, lazy-loaded
    // so no pack data rides the page. English needs none: python() already
    // highlights English natively, and the canonical view is English text.
    const termModules = import.meta.glob<{
      default: { k: string[]; a: string[]; b: string[]; s: Record<string, string> };
    }>('../../.astro/integrations/legesher-snippets/highlight-terms/*.json');
    const termCache = new Map<string, HighlightTerms>();
    const loadTerms = async (lang: string) => {
      if (lang === 'en' || termCache.has(lang)) return;
      const mod =
        termModules[`../../.astro/integrations/legesher-snippets/highlight-terms/${lang}.json`];
      if (!mod) return;
      try {
        termCache.set(lang, toTermSets((await mod()).default));
      } catch {
        /* chunk failed to load — this language stays unhighlighted */
      }
    };
    await loadTerms(currentLang);

    const editor = mountEditor({
      parent: editorParent,
      doc: sharedCode ?? seedFor(),
      onRun: () => run(),
      // The URL only ever mirrors the localized source, never the canonical view.
      onChange: () => view === 'source' && scheduleUrlSync(),
      extensions: [
        localizedHighlight(() =>
          view === 'canonical' ? null : (termCache.get(currentLang) ?? null),
        ),
      ],
    });

    // Keep the query string shareable: it always mirrors the localized buffer
    // (src stays 'en' — the canonical source language of every pack).
    const localizedSource = () => (view === 'source' ? editor.getDoc() : savedSource);
    let urlTimer: ReturnType<typeof setTimeout> | null = null;
    const writeUrl = () => {
      const next = new URLSearchParams(location.search);
      next.set('code', encodeShareCode(localizedSource()));
      next.set('src', 'en');
      next.set('tgt', currentLang);
      next.set('sample', currentSample);
      history.replaceState(null, '', `${location.pathname}?${next}${location.hash}`);
    };
    const scheduleUrlSync = () => {
      if (urlTimer) clearTimeout(urlTimer);
      urlTimer = setTimeout(writeUrl, URL_SYNC_DEBOUNCE_MS);
    };

    let shareResetTimer: ReturnType<typeof setTimeout> | null = null;
    shareBtn.addEventListener('click', async () => {
      if (busy || translating) return;
      let label = 'Copied';
      try {
        if (view === 'canonical' && editor.getDoc() !== canonicalShown) {
          // The canonical view has edits: the copied URL must reproduce what
          // the user currently sees, so forward-translate first (the same
          // path toggle-back uses). Never share a URL that restores older
          // code. The worker is already booted here — reaching the canonical
          // view required a translate — so this stays within the clipboard
          // user-activation window.
          setTranslating(true);
          try {
            const current = editor.getDoc();
            let localized = await runner.translate(current, currentLang, 'from-en', bootStatus);
            const glossary = glossaryFor();
            if (glossary) localized = swapIdentifiers(localized, glossary);
            savedSource = localized;
            canonicalShown = current; // toggle-back now restores exactly this
          } finally {
            setStatus('');
            setTranslating(false);
          }
        }
        if (urlTimer) clearTimeout(urlTimer);
        writeUrl(); // flush so the copied link matches the buffer exactly
        await navigator.clipboard.writeText(location.href);
      } catch {
        label = 'Copy failed';
      }
      shareBtn.textContent = label;
      if (shareResetTimer) clearTimeout(shareResetTimer);
      shareResetTimer = setTimeout(() => {
        shareBtn.textContent = 'Copy link';
      }, 1500);
    });

    const runner = createRunner();
    let busy = false;

    const setStatus = (text: string) => {
      statusEl.hidden = !text;
      statusEl.textContent = text;
    };
    const bootStatus = (phase: string, message: string) => {
      if (phase === 'booting' || phase === 'installing') {
        setStatus(`${message} First run only — cached for future visits.`);
      }
    };
    const append = (text: string, cls?: string) => {
      const span = document.createElement('span');
      if (cls) span.className = cls;
      span.textContent = text;
      outputEl.appendChild(span);
    };
    const setBusy = (b: boolean) => {
      busy = b;
      runBtn.disabled = b;
      langSel.disabled = b;
      sampleSel.disabled = b;
      toggleBtn.disabled = b;
      shareBtn.disabled = b;
      runBtn.textContent = b ? 'Running…' : 'Run ▶';
    };

    const nativeName = () => offered.find((l) => l.code === currentLang)?.native ?? currentLang;
    const updateToggleUi = () => {
      // English source is already canonical; the toggle has nothing to show.
      toggleBtn.hidden = currentLang === 'en';
      toggleBtn.textContent = view === 'source' ? 'Show English' : `Show ${nativeName()}`;
      viewNoteEl.hidden = view === 'source';
    };
    updateToggleUi();

    const setTranslating = (b: boolean) => {
      translating = b;
      toggleBtn.disabled = b;
      runBtn.disabled = b;
      langSel.disabled = b;
      sampleSel.disabled = b;
      shareBtn.disabled = b;
    };

    toggleBtn.addEventListener('click', async () => {
      if (busy || translating) return;
      setTranslating(true);
      try {
        if (view === 'source') {
          savedSource = editor.getDoc();
          let english = await runner.translate(savedSource, currentLang, 'to-en', bootStatus);
          // Sample identifiers are localized display-layer tokens the engine
          // passes through; map them back so the canonical view is English.
          const glossary = glossaryFor();
          if (glossary) english = swapIdentifiers(english, invertGlossary(glossary));
          canonicalShown = english;
          view = 'canonical'; // before setDoc so onChange skips the URL sync
          editor.setDoc(english);
        } else {
          const current = editor.getDoc();
          let restored: string;
          if (current === canonicalShown) {
            restored = savedSource; // untouched canonical view: exact bytes back
          } else {
            restored = await runner.translate(current, currentLang, 'from-en', bootStatus);
            const glossary = glossaryFor();
            if (glossary) restored = swapIdentifiers(restored, glossary);
          }
          view = 'source'; // before setDoc so onChange resumes the URL sync
          editor.setDoc(restored);
        }
        updateToggleUi();
      } catch (e) {
        if (outputEl.textContent) append('\n');
        append('Translation error:\n', 'pg-error');
        append(((e as Error).message || String(e)) + '\n', 'pg-error');
      } finally {
        setStatus('');
        setTranslating(false);
      }
    });

    function run() {
      if (busy || translating) return;
      outputEl.textContent = '';
      setBusy(true);
      setStatus('Starting…');
      // The canonical view is English text, so it runs without translation.
      runner.run(editor.getDoc(), view === 'canonical' ? 'en' : currentLang, {
        onStatus: (phase, message) => {
          if (phase === 'booting' || phase === 'installing') {
            setStatus(`${message} First run only — cached for future visits.`);
          } else if (phase === 'running') {
            setStatus('Running…');
          }
        },
        onOutput: (stream, line) => append(line + '\n', stream === 'stderr' ? 'pg-stderr' : undefined),
        onError: (phase, message) => {
          const label =
            phase === 'translate'
              ? 'Translation error'
              : phase === 'timeout'
                ? 'Stopped'
                : phase === 'boot'
                  ? 'Runtime failed to start'
                  : 'Error';
          if (outputEl.textContent) append('\n');
          append(`${label}:\n`, 'pg-error');
          append(message.replace(/\n$/, '') + '\n', 'pg-error');
          setStatus('');
          setBusy(false);
        },
        onResult: () => {
          if (!outputEl.textContent) append('(no output)', 'pg-muted');
          setStatus('');
          setBusy(false);
        },
      });
    }

    langSel.addEventListener('change', async () => {
      const next = langSel.value;
      if (next === currentLang) return;
      currentLang = next;
      view = 'source'; // reseeding replaces the buffer, so leave the canonical view
      // Gate Run/toggle/copy while the highlight terms load: they must not
      // operate on the old-language buffer under the new language.
      setTranslating(true);
      try {
        await loadTerms(next); // so the reseeded doc decorates immediately
      } finally {
        setTranslating(false);
      }
      editor.setDoc(seedFor());
      outputEl.textContent = '';
      setStatus('');
      updateToggleUi();
      scheduleUrlSync();
    });

    // A playground, not an IDE: picking a sample replaces the buffer without
    // asking, and the share URL follows along.
    sampleSel.addEventListener('change', () => {
      const next = sampleSel.value;
      if (next === currentSample) return;
      currentSample = next;
      view = 'source';
      editor.setDoc(seedFor());
      outputEl.textContent = '';
      setStatus('');
      updateToggleUi();
      scheduleUrlSync();
    });

    runBtn.addEventListener('click', run);
  }
</script>

<style>
  .pg {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-block: 1.5rem;
  }
  .pg-toolbar {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .pg-lang-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
  }
  .pg-toolbar select {
    background: var(--sl-color-bg);
    color: inherit;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    padding: 0.25rem 0.4rem;
  }
  .pg-run {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    border: none;
    border-radius: 0.25rem;
    padding: 0.4rem 1rem;
    font-weight: 600;
    cursor: pointer;
  }
  .pg-run:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .pg-secondary {
    background: transparent;
    color: inherit;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    padding: 0.4rem 1rem;
    font-weight: 600;
    cursor: pointer;
  }
  .pg-secondary:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .pg-status {
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
  }
  .pg-editor {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    overflow: hidden;
    max-height: 24rem;
  }
  .pg-editor :global(.cm-editor) {
    max-height: 24rem;
  }
  .pg-output-wrap {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .pg-output-head {
    background: var(--sl-color-gray-6);
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--sl-color-gray-2);
  }
  .pg-output {
    margin: 0;
    padding: 0.75rem;
    min-height: 3rem;
    max-height: 16rem;
    overflow: auto;
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
    font-size: 0.85rem;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .pg-stderr {
    color: var(--sl-color-orange-high);
  }
  .pg-error {
    color: var(--sl-color-red-high);
    font-weight: 600;
  }
  .pg-muted {
    color: var(--sl-color-gray-3);
    font-style: italic;
  }
  .pg-rtl-note {
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
    margin: 0;
  }
</style>
