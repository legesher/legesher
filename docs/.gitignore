# Playground Pyodide wheels (public/wheels/*.whl) are intentionally COMMITTED
# and served as static assets — never ignore them. Regenerate with
# docs/scripts/build_wheels.sh, then commit the result. See CORE-1551.
!public/wheels/

# build output
dist/
.vercel/
# playwright output
test-results/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store
