# Legesher Environment Configuration
# Copy this file to .env and fill in your values
#
# Required keys are marked with (required). All others are optional with defaults shown.

# ============================================================================
# Core / Language Server Configuration
# ============================================================================

# Translator backend: "true" for tree-sitter AST, "false" for token-based (default: false)
# LEGESHER_USE_TREE_SITTER=false

# Maximum cached translations — LRU cache (default: 1000, range: 1-10000)
# LEGESHER_CACHE_SIZE=1000

# Cache time-to-live in seconds (default: 3600, 0 = no expiration)
# LEGESHER_CACHE_TTL=3600

# Source language code, ISO 639-1 (default: en)
# LEGESHER_SOURCE_LANG=en

# Target display language code, ISO 639-1 (default: en)
# LEGESHER_TARGET_LANG=en

# Python version for language pack selection (default: auto-detected from runtime)
# LEGESHER_PYTHON_VERSION=3.13

# Enable enhanced Python intelligence (default: true)
# Requires `pyright-langserver`, which `npm install -g pyright` provides.
# LEGESHER_ENHANCED_INTELLIGENCE_ENABLED=true

# Path to the Python language server executable (default: auto-detected)
# LEGESHER_LANGUAGE_SERVER_PATH=

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
# LEGESHER_LOG_LEVEL=INFO

# ============================================================================
# Translation API Keys
# ============================================================================
# At least one provider is needed for AI-powered translations.
# Aya 23 runs locally via Ollama and requires no API key.

# Anthropic Claude API key (required for Claude translations)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key (not yet used — reserved for future provider support)
# OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud Translation API key
# GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# Google Cloud project ID (required if using Google Translate)
# GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id

# DeepL API key
# DEEPL_API_KEY=your_deepl_api_key_here

# LibreTranslate API key (optional if using a public instance)
# LIBRETRANSLATE_API_KEY=your_libretranslate_api_key_here

# LibreTranslate server URL (default: http://localhost:5000)
# LIBRETRANSLATE_HOST=http://localhost:5000

# Ollama model server URL (default: http://localhost:11434)
# Install Ollama: https://ollama.com/download
# Pull Aya model: ollama pull aya:23
# OLLAMA_HOST=http://localhost:11434

# Hugging Face API token (required for Aya inference API)
# Get your token at: https://huggingface.co/settings/tokens
# HF_TOKEN=your_huggingface_token_here

# ============================================================================
# VS Code Extension (build-time)
# ============================================================================

# Azure Application Insights connection string for telemetry
# Injected at build time via esbuild — not needed for local development
# LEGESHER_TELEMETRY_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# User feedback form URL (default: https://legesher.io/go/vs-code-extension-survey)
# LEGESHER_FEEDBACK_URL=https://legesher.io/go/vs-code-extension-survey

# ============================================================================
# Pipeline / Monitoring (for translation scripts)
# ============================================================================

# GitHub API request timeout in seconds (default: 10)
# LEGESHER_GITHUB_TIMEOUT=10

# Maximum retry attempts for GitHub API (default: 3)
# LEGESHER_GITHUB_MAX_RETRIES=3
