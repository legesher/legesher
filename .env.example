# Legesher AI Translation Pipeline Configuration
# Copy this file to .env and fill in your API keys

# ============================================================================
# API Keys
# ============================================================================

# Anthropic Claude API Key (required for Claude 3.5 Sonnet translations)
# Get your API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Note: Aya 23 runs locally via Ollama, no API key required
# Install Ollama: https://ollama.com/download
# Pull Aya model: ollama pull aya:23

# ============================================================================
# Database Configuration
# ============================================================================

# Path to translation database (default: .legesher/translations.db)
TRANSLATION_DB_PATH=.legesher/translations.db

# ============================================================================
# Pipeline Configuration
# ============================================================================

# Dry run mode - set to "true" to test without making API calls
DRY_RUN=false

# Budget limit in USD (pipeline will stop if this is exceeded)
BUDGET_LIMIT_USD=1000.00

# Maximum concurrent API requests (for rate limiting)
MAX_CONCURRENT_REQUESTS=10

# Retry attempts for failed API calls
MAX_RETRIES=3

# ============================================================================
# Model Configuration
# ============================================================================

# Claude model version
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Aya/Ollama model name
AYA_MODEL=aya:23

# ============================================================================
# Context Paths (optional - uses defaults if not set)
# ============================================================================

# Path to deep context documents directory
# CONTEXT_DIR=libs/i18n/context/python

# Path to linguistic standards file
# LINGUISTIC_STANDARDS_FILE=libs/i18n/docs/linguistic-standards.md

# Path to Python terms manifest
# TERM_MANIFEST_FILE=libs/i18n/data/python-terms-manifest.json

# ============================================================================
# Logging
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (optional - logs to console if not set)
# LOG_FILE=translation-pipeline.log
